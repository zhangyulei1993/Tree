# H5 本地开发（走 Vite dev server proxy：/api -> http://127.0.0.1:8080）
VITE_API_MODE=real
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# H5 本地界面联调 staging 数据时改为：
# VITE_API_PROXY_TARGET=https://tapi.bigbigboy.cn
# 或使用：pnpm dev:h5:staging

# Mock 模式（不接后端）
# VITE_API_MODE=mock
# VITE_API_BASE_URL=/api

# 微信小程序请勿在此文件写 localhost。
# 小程序 real 模式请复制 .env.staging.example，或使用：
#   pnpm dev:mp-weixin:staging
#   pnpm build:mp-weixin:staging
