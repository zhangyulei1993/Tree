# H5 本地开发（走 Vite dev server proxy：/api -> http://127.0.0.1:8080）
# 对应命令：pnpm dev:h5:local / pnpm build:h5:local
VITE_API_MODE=real
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# 其他环境文件：
#   .env.mp-local   -> 微信小程序本地开发，完整本机 API 地址
#   .env.staging-h5 -> H5 staging，/api 通过 Vite proxy 到 HTTPS API
#   .env.staging-mp -> 微信小程序 staging/体验版，完整 HTTPS API 地址

# Mock 模式（不接后端）
# VITE_API_MODE=mock
# VITE_API_BASE_URL=/api

# 推荐使用以下命令；微信开发者工具固定打开 dist/mp-weixin：
#   pnpm dev:mp-weixin:local
#   pnpm dev:mp-weixin:staging
#   pnpm build:mp-weixin:local
#   pnpm build:mp-weixin:staging
