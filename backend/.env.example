APP_ENV=dev
APP_NAME=Tree
APP_PORT=8080

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=tree_user
MYSQL_PASSWORD=tree_pass
MYSQL_DATABASE=tree_platform
MYSQL_CHARSET=utf8mb4

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
